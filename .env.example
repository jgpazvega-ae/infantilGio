# Copia este archivo a ".env" y rellena tus credenciales.
# El .env NUNCA debe subirse al repositorio (está en .gitignore).

# --- ElevenLabs (obligatorio para generar narración) ---
ELEVENLABS_API_KEY=
# (Opcional) Sobrescribe el voice_id del narrador definido en config/voices.yaml
ELEVENLABS_VOICE_ID=

# --- YouTube (SOLO para la Fase 10; no es necesario todavía) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_CHANNEL_ID=
