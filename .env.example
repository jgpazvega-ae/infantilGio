# Copia este archivo a ".env" y rellena tus credenciales.
# El archivo .env NUNCA debe subirse al repositorio (está en .gitignore).

# Clave de API de ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=

# (Opcional) Sobrescribe el voice_id por defecto definido en config.py
# ELEVENLABS_VOICE_ID=
